# Your personal settings for the gagnvist starter kit.
#
# Copy this file to .env (in the same folder) and fill in the three values below.
# .env is yours alone: git ignores it, so it is never committed or pushed.
# On Windows, a path can be written as it is: C:\Users\you\.ssh\id_ed25519_lumi

GAGNVIST_LUMI_USERNAME=your_lumi_username
GAGNVIST_SSH_KEY=~/.ssh/id_ed25519_lumi
GAGNVIST_TEAM_KEY=paste-your-team-key-here

# Only for a model server of your own (see docs/lumi.md):
# `gagnvist lumi connect --job ...` prints the lines to put here.
# GAGNVIST_CHAT_MODEL=
# GAGNVIST_CHAT_URL=
# GAGNVIST_CHAT_KEY=
# GAGNVIST_EMBEDDINGS_MODEL=
# GAGNVIST_EMBEDDINGS_URL=
# GAGNVIST_EMBEDDINGS_KEY=
