# Your personal settings for the gagnvist starter kit.
#
# Copy this file to .env (in the same folder) and fill in the three values below.
# .env is yours alone: git ignores it, so it is never committed or pushed.
# On Windows, a path can be written as it is: C:\Users\you\.ssh\id_ed25519_jureca
# A variable of the same name in your environment overrides the value in .env.

GAGNVIST_JURECA_USERNAME=your_jureca_username
GAGNVIST_JURECA_SSH_KEY=~/.ssh/id_ed25519_jureca
GAGNVIST_TEAM_KEY=paste-your-team-key-here

# Only if port 8775 is taken on your computer:
# GAGNVIST_JURECA_LOCAL_PORT=8790
# Only to try cards and a vector index of your own (see docs/re-embedding.md):
# GAGNVIST_SEARCH_CARDS=local/my-cards
# GAGNVIST_SEARCH_INDEX=local/my-index

# Only for a model server of your own (see docs/jureca.md):
# `gagnvist jureca connect --job ...` prints the lines to put here.
# GAGNVIST_CHAT_MODEL=
# GAGNVIST_CHAT_URL=
# GAGNVIST_CHAT_KEY=
# GAGNVIST_EMBEDDINGS_MODEL=
# GAGNVIST_EMBEDDINGS_URL=
# GAGNVIST_EMBEDDINGS_KEY=
