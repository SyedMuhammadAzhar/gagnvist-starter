# Your personal settings for the gagnvist starter kit.
#
# Copy this file to .env (in the same folder) and fill in the three values below.
# .env is yours alone: git ignores it, so it is never committed or pushed.
# On Windows, a path can be written as it is: C:\Users\you\.ssh\id_ed25519_lumi

GAGNVIST_LUMI_USERNAME=your_lumi_username
GAGNVIST_SSH_KEY=~/.ssh/id_ed25519_lumi
GAGNVIST_TEAM_KEY=paste-your-team-key-here

# Only if the hackathon's shared models also run on JURECA (see docs/jureca.md):
# your JuDoor username and the key you registered there. GAGNVIST_CLUSTER says whose
# shared models the commands use, lumi (the default) or jureca; `--cluster` on a command
# does the same for that command only.
# GAGNVIST_JURECA_USERNAME=your_jureca_username
# GAGNVIST_JURECA_SSH_KEY=~/.ssh/id_ed25519_jureca
# GAGNVIST_CLUSTER=jureca

# Only if port 8765 (or 8775, the tunnel to JURECA) is taken on your computer:
# GAGNVIST_LOCAL_PORT=8790
# GAGNVIST_JURECA_LOCAL_PORT=8791
# Only to try cards and a vector index of your own (see docs/re-embedding.md):
# GAGNVIST_SEARCH_CARDS=local/my-cards
# GAGNVIST_SEARCH_INDEX=local/my-index

# Only for a model server of your own (see docs/lumi.md):
# `gagnvist lumi connect --job ...` (or `gagnvist jureca connect --job ...`) prints the
# lines to put here.
# GAGNVIST_CHAT_MODEL=
# GAGNVIST_CHAT_URL=
# GAGNVIST_CHAT_KEY=
# GAGNVIST_EMBEDDINGS_MODEL=
# GAGNVIST_EMBEDDINGS_URL=
# GAGNVIST_EMBEDDINGS_KEY=
